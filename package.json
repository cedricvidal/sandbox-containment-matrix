{
  "name": "sandbox-mxc-sdk-typescript",
  "version": "0.1.0",
  "description": "Experiment exercising Microsoft eXecution Containers (MXC) through the @microsoft/mxc-sdk TypeScript SDK",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "hello": "tsx src/hello-sandbox.ts",
    "probe": "tsx src/platform-probe.ts",
    "probes": "tsx src/escape-probes.ts",
    "latency": "tsx src/trusted-latency.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mxc",
    "sandbox",
    "seatbelt",
    "bubblewrap",
    "processcontainer",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@microsoft/mxc-sdk": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  }
}
